# Release to run: 2 follows the latest 2.x, or pin one like 2.2.0
MONERO_MERCHANT_VERSION=2

# ------------------------
# Public ports
# ------------------------
# Gateway port for the vendor portal and API. Also the POS backend URL.
HTTP_PORT=8080
HTTPS_PORT=8443
# Domain for automatic HTTPS (needs HTTP_PORT=80 and HTTPS_PORT=443)
SITE_ADDRESS=
# Address of a proxy in front of the gateway, if any
TRUSTED_PROXIES=

# Localhost only
MONEROPAY_PORT=5000
BACKEND_DB_PORT=55432

# ------------------------
# MoneroPay database
# ------------------------
MONEROPAY_POSTGRES_USERNAME=moneropay
MONEROPAY_POSTGRES_PASSWORD=
MONEROPAY_POSTGRES_DATABASE=moneropay

# ------------------------
# Monero daemon
# ------------------------
MONERO_DAEMON_RPC_HOSTNAME=xmr-node.cakewallet.com
MONERO_DAEMON_RPC_PORT=18081
# Leave empty unless the node uses --rpc-login
MONERO_DAEMON_RPC_USERNAME=
MONERO_DAEMON_RPC_PASSWORD=

# ------------------------
# Backend admin
# ------------------------
ADMIN_NAME=admin
ADMIN_PASSWORD=

# ------------------------
# Backend database
# ------------------------
DB_HOST=backend-db
DB_USER=moneromerchant
DB_PASSWORD=
DB_NAME=moneromerchant
DB_PORT=5432

# ------------------------
# Backend JWT secrets
# ------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_MONEROPAY_SECRET=
# Optional, enables the LWS webhook
JWT_LWS_TOKEN=

# ------------------------
# Backend → MoneroPay
# ------------------------
MONEROPAY_BASE_URL=http://moneropay:5000
MONEROPAY_CALLBACK_URL=http://backend:8080/api/callback/

# ------------------------
# Monero RPC (backend)
# ------------------------
MONERO_DAEMON_RPC_ENDPOINT=http://xmr-node.cakewallet.com:18081/json_rpc
MONERO_WALLET_RPC_ENDPOINT=http://monero-wallet-rpc:28081/json_rpc
# Required; setup.sh generates both
MONERO_WALLET_RPC_USERNAME=
MONERO_WALLET_RPC_PASSWORD=

# ------------------------
# Wallet
# ------------------------
WALLET_AUTO_REFRESH_PERIOD=2
